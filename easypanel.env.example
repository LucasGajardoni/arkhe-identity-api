APP_NAME=Arkhe Identity API
ENVIRONMENT=production
PORT=8000
DEBUG=false
ENABLE_API_DOCS=true
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/arkhe_identity
CORS_ORIGINS=https://SEU-SUBDOMINIO-EASYPANEL.easypanel.host
DATA_ENCRYPTION_KEY=GERAR_COM_scripts/generate_secrets.py
LOOKUP_HMAC_KEY=GERAR_COM_scripts/generate_secrets.py
JWT_SECRET=GERAR_COM_scripts/generate_secrets.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=GERAR_COM_scripts/generate_secrets.py
FACIAL_SIMILARITY_THRESHOLD=0.85
FACIAL_THRESHOLD_EXPERIMENTAL=true
MAX_IMAGE_SIZE_MB=3
FACE_MODEL_NAME=opencv-yunet-sface
FACE_MODEL_VERSION=YuNet-2023mar-SFace-2021dec
FACE_BACKEND=opencv
FACE_DETECTOR_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
FACE_RECOGNIZER_MODEL_PATH=models/face_recognition_sface_2021dec.onnx
FORWARDED_ALLOW_IPS=127.0.0.1
