APP_NAME=Arkhe Identity API
ENVIRONMENT=local
PORT=8000
DEBUG=false
DATABASE_URL=postgresql+psycopg://arkhe:arkhe_dev_password@postgres:5432/arkhe_identity
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DATA_ENCRYPTION_KEY=base64-32-bytes-generated-with-scripts/generate_secrets.py
LOOKUP_HMAC_KEY=base64-32-bytes-generated-with-scripts/generate_secrets.py
JWT_SECRET=change-me-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$replace_with_passlib_bcrypt_hash
API_KEY_HASH=replace_with_hmac_or_bcrypt_hash
API_KEY_PLAINTEXT_FOR_LOCAL_ONLY=
REQUIRE_PRIVACY_OBJECT=false
TEXT_SIMILARITY_THRESHOLD=0.90
FACIAL_SIMILARITY_THRESHOLD=0.85
FACIAL_THRESHOLD_EXPERIMENTAL=true
MAX_IMAGE_SIZE_MB=3
STORE_REFERENCE_IMAGES=false
REFERENCE_IMAGE_DIR=/tmp/arkhe-reference-images
IDENTITY_PROVIDER=private_registry
FACE_MODEL_NAME=opencv-yunet-sface
FACE_MODEL_VERSION=YuNet-2023mar-SFace-2021dec
FACE_BACKEND=opencv
FACE_DETECTOR_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
FACE_RECOGNIZER_MODEL_PATH=models/face_recognition_sface_2021dec.onnx
